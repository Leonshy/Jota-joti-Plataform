# Plantilla del .env de PRODUCCIÓN (Plesk). Copiala a .env en el servidor y completá lo que falta.
# Nunca subas el .env real a git. Después de editarlo: php artisan config:cache && php artisan jota:verificar-produccion

APP_NAME="JOTA-JOTI 2026"
APP_ENV=production
APP_KEY=              # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://CAMBIAR-POR-EL-DOMINIO

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
# 10 vueltas: el ingreso (bcrypt) es lo más pesado de la plataforma y a las 8 de la mañana entran cientos a la vez. Con 12 cada ingreso
# cuesta ~250 ms de procesador; con 10, ~65 ms. Un PIN de 4 dígitos no gana seguridad con más vueltas (son solo 10.000 combinaciones).
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sesión larga (3 días): dura todo el evento. La cookie viaja solo por https.
SESSION_DRIVER=database
SESSION_LIFETIME=4320
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Plesk pone nginx delante de Apache: se confía en el proxy para saber que el visitante entró por https.
# Usá «*» solo si el servidor no es alcanzable sin pasar por el proxy.
TRUSTED_PROXIES=*
# Además del dominio de APP_URL, otros nombres con los que se puede entrar (separados por coma). Normalmente vacío.
TRUSTED_HOSTS=

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Solo para el seeder de PRUEBA, que NO corre en producción. No definas SEED_PIN acá.

# Respaldo horario de la base (spatie/laravel-backup). El .zip se cifra con esta contraseña: guardala aparte, sin ella no se puede restaurar.
# Generá una larga con:  php -r "echo bin2hex(random_bytes(24));"
BACKUP_ARCHIVE_PASSWORD=
# Carpeta de mysqldump si no está en el PATH (en Plesk suele ser /usr/bin). Normalmente vacío.
DB_DUMP_PATH=
